CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/merlin"
CONFIG_MTK_REVERSE_CHG_ENABLE=y
CONFIG_TARGET_PRODUCT_MERLIN=y
CONFIG_ARCH_MTK_PROJECT="merlin"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="s5kgm1sp_mipi_raw s5kgm1sp_sunny_mipi_raw ov13b10_mipi_raw ov13b10_sunny_mipi_raw s5k4h7yx_mipi_raw s5k4h7yx_sunny_mipi_raw ov2180_mipi_raw ov2180_sunny_mipi_raw gc02m1_macro_mipi_raw gc02m1_macro_sunny_mipi_raw ov2680_sunny_mipi_raw"
CONFIG_CUSTOM_KERNEL_LCM="nt36672A_fhdp_dsi_vdo_tianma ft8719_fhdp_dsi_vdo_xinli nt36672A_fhdp_dsi_vdo_tianma_G6 nt36672D_fhdp_dsi_vdo_tianma"
CONFIG_CUSTOM_KERNEL_UNCALI_GYRO_SENSOR=y
CONFIG_MTK_UNCALI_GYROHUB=y
CONFIG_SWTP_DRIVER=y
CONFIG_SWITCH=y
CONFIG_MTK_LENS_DW9800WAF_SUPPORT=y
CONFIG_MTK_LENS_DW9714VAF_SUPPORT=y
CONFIG_MTK_LENS_CN3927AF_SUPPORT=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"
CONFIG_SND_SOC_CS35L41=y
CONFIG_SND_SOC_CS35L41_SPI=y

# ---------------------------------------------------------------------------
# Memory pressure handling. 4 GB device: zram swap + PSI keep lmkd from
# killing Chromium instead of compressing page cache, which is what made the
# browser feel "heavy". These were present in the previous (unreproducible)
# build but are not defaults anywhere in the tree, so they are pinned here.
# ---------------------------------------------------------------------------
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y

# Utilization clamping: without this, the perf hints Android sends for UI and
# render threads are dropped and schedutil decides the whole frequency climb
# on its own.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# /proc/config.gz, so the running config can be verified on the device.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot cmdline of the ROM passes page_owner=on; it is pure allocation overhead
# here and nothing reads the output.
# CONFIG_PAGE_OWNER is not set

# Scheduler statistics: a few instructions on every enqueue/dequeue and 32
# bytes in every task_struct. Only kernel/profile.c sleep profiling reads
# them, and that is not built.
# CONFIG_SCHEDSTATS is not set

# DWARF generation is one of the slowest steps of this build (worse under
# LTO) and only affects vmlinux size. Nothing here debugs vmlinux.
# CONFIG_DEBUG_INFO is not set

# ---------------------------------------------------------------------------
# Hardware that is not fitted on this variant. The merlin board has no NFC
# (no PN553), so the drivers only cost boot time and RAM. FM radio IS present
# on this variant and stays enabled.
# ---------------------------------------------------------------------------
# CONFIG_NFC is not set
# CONFIG_NFC_PN553_19A_DEVICES is not set
# CONFIG_NFC_PN553_DEVICES is not set
# NXP P73 is the eSE (secure element) SPI driver; it only exists to relay
# ioctls into drivers/nfc/pn553.c, so it cannot be built without PN553.
# CONFIG_NXP_P73_DEVICES is not set

# CD-ROM filesystem: nothing on this phone mounts an ISO image, and the base
# config enables it for no reason.
# CONFIG_ISO9660_FS is not set
